        "id": "3d655d1f"
      },
      "outputs": [],
      "source": [
        "# Simulate SEIR for each region\n",
        "states = np.zeros((n_regions, T, 4))\n",
        "incidence = np.zeros((n_regions, T))\n",
        "\n",
        "for i in range(n_regions):\n",
        "    # Solve ODE\n",
        "    sol = odeint(seir, initial_state[i], t, args=(beta[i], sigma, gamma, N[i]))\n",
        "    states[i] = sol\n",
        "    # Incidence = new infections = beta * S * I / N\n",
        "    incidence[i] = beta[i] * sol[:, 0] * sol[:, 2] / N[i]"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 7,
      "id": "74b4dce7",
      "metadata": {
        "id": "74b4dce7"
      },
      "outputs": [],
      "source": [
        "# Generate observed cases using negative binomial\n",
        "observed_cases = np.zeros((n_regions, T), dtype=int)\n",
        "for i in range(n_regions):\n",
        "    for t in range(T):\n",
        "        mean_cases = reporting_rate * incidence[i, t]\n",
        "        # Negative binomial: r = phi (dispersion), p = phi/(phi + mean)\n",
        "        p = phi / (phi + mean_cases)\n",
        "        r = phi\n",
        "        observed_cases[i, t] = np.random.negative_binomial(r, p)\n"
      ]
    },
